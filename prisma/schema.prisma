generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Texts {
  id               Int    @id @default(autoincrement())
  frontpageHeading String
  frontpageMessage String
}

model Day {
  id                  Int        @id @default(autoincrement())
  difficulty          Int?
  points              Int?
  image               String?
  description         String?
  video               String?
  solutionVideo       String?
  solutionDescription String?
  date                DateTime
  artist              String
  song                String
  hint1               String?
  hint2               String?
  hint3               String?
  hasTextSolution     Boolean?
  hasFileHint1        Boolean?
  hasFileHint2        Boolean?
  hasFileHint3        Boolean?
  madeBy              String?
  solution            Solution[]
  answers             Answer[]
  file                SongFile?
  Hint                Hint[]
}

model SongFile {
  id        Int     @id @default(autoincrement())
  dayId     Int     @unique
  file      String
  hint1file String?
  hint2file String?
  hint3file String?
  day       Day     @relation(fields: [dayId], references: [id], onDelete: Cascade)
}

model Solution {
  id       Int    @id @default(autoincrement())
  solution String
  dayId    Int
  day      Day    @relation(fields: [dayId], references: [id], onDelete: Cascade)
}

model Answer {
  id          Int      @id @default(autoincrement())
  points      Int
  timeOfEntry DateTime
  dayId       Int
  day         Day      @relation(fields: [dayId], references: [id], onDelete: Cascade)
  userId      Int
  user        User     @relation(fields: [userId], references: [id])

  @@unique([dayId, userId])
}

model Hint {
  id     Int     @id @default(autoincrement())
  hint1  Boolean
  hint2  Boolean
  hint3  Boolean
  dayId  Int
  day    Day     @relation(fields: [dayId], references: [id], onDelete: Cascade)
  userId Int
  user   User    @relation(fields: [userId], references: [id])

  @@unique([dayId, userId])
}

model Account {
  id                    Int       @id @default(autoincrement())
  userId                Int       @map("user_id")
  providerId            String    @map("provider")
  accountId             String    @map("provider_account_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique @map("session_token")
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model User {
  id            Int       @id @default(autoincrement())
  name          String?
  nickname      String?
  email         String?   @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map(name: "created_at")
  updatedAt     DateTime  @updatedAt @map(name: "updated_at")
  accounts      Account[]
  sessions      Session[]
  role          String?

  answer Answer[]

  hints Hint[]

  @@map(name: "users")
}

// Short-lived values Better Auth needs, such as OAuth state.
model Verification {
  id         Int      @id @default(autoincrement())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}
